{
  "name": "emdash-multisite",
  "version": "0.7.0",
  "description": "Run many EmDash sites from one Cloudflare Worker and one D1 database. Per-site table prefixing in the Kysely dialect, per-site caches via a build-time patch, and hostname-based site resolution. No Workers for Platforms, no fork of EmDash core.",
  "license": "MIT",
  "author": "The Weekend Projects",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theweekendprojects/emdash-multisite.git"
  },
  "homepage": "https://github.com/theweekendprojects/emdash-multisite#readme",
  "bugs": {
    "url": "https://github.com/theweekendprojects/emdash-multisite/issues"
  },
  "keywords": [
    "emdash",
    "emdash-cms",
    "cms",
    "multi-tenant",
    "multisite",
    "multi-site",
    "cloudflare",
    "cloudflare-workers",
    "d1",
    "astro",
    "kysely"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "emdash-multisite": "./bin/setup.mjs"
  },
  "files": [
    "src",
    "templates",
    "bin",
    "README.md",
    "SETUP.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./db/d1": "./src/db/d1.ts",
    "./db/sqlite": "./src/db/sqlite.ts",
    "./provision": "./src/provision.ts",
    "./vite": "./src/vite.ts",
    "./middleware": "./src/middleware.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./fleet": "./src/fleet.ts",
    "./scheduled": "./src/scheduled.ts",
    "./storage": "./src/storage.ts",
    "./auth-ui": "./src/auth-ui.ts",
    "./auth-links": "./src/auth-links.ts",
    "./plugin-entry": "./src/plugin-entry.ts",
    "./plugin": "./src/plugin.ts",
    "./edge-cache": "./src/edge-cache.ts"
  },
  "scripts": {
    "selfcheck": "node --no-warnings scripts/selfcheck.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "emdash": ">=0.30.0",
    "@emdash-cms/cloudflare": "*",
    "kysely": ">=0.29.0",
    "@better-auth-ui/core": "*",
    "react": "*",
    "@heroui/react": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "@emdash-cms/cloudflare": {
      "optional": true
    },
    "@better-auth-ui/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@heroui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "kysely": "0.29.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
